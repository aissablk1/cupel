{
  "name": "cupel",
  "version": "0.0.1",
  "private": true,
  "description": "Marketplace de skills IA pour devs pro",
  "author": "Aïssa BELKOUSSA <contact@aissabelkoussa.fr>",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter web start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter web test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,sql}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,sql}\"",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:types": "supabase gen types typescript --local > packages/shared/src/database.types.ts",
    "supabase:push": "supabase db push",
    "cli:build": "pnpm --filter cupel build",
    "cli:link": "pnpm --filter cupel link --global",
    "security:scan": "pnpm --filter @cupel/security scan",
    "clean": "pnpm -r exec rm -rf .next dist .turbo node_modules && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2"
  }
}
