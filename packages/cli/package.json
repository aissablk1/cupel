{
  "name": "@forgekit/cli",
  "version": "0.0.1",
  "description": "Forgekit CLI — install, manage and publish AI dev skills",
  "author": "Aïssa BELKOUSSA <contact@aissabelkoussa.fr>",
  "license": "MIT",
  "type": "module",
  "bin": {
    "forgekit": "./bin/forgekit.mjs"
  },
  "files": ["bin", "dist", "templates", "README.md"],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@forgekit/shared": "workspace:*",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "conf": "^13.0.1",
    "inquirer": "^11.0.2",
    "open": "^10.1.0",
    "ora": "^8.1.0",
    "tar": "^7.4.3",
    "undici": "^6.20.0",
    "yauzl": "^3.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/yauzl": "^2.10.3",
    "@types/node": "^22.7.4",
    "tsup": "^8.3.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": ["claude-code", "cursor", "ai", "skills", "marketplace", "cli"]
}
