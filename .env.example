# =============================================================================
# cupel — Variables d'environnement
# Ne JAMAIS commiter .env.local
# Secrets prod : Vercel + Supabase Vault + Cloudflare secrets
# =============================================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:5309
# Port à vie alloué à cupel : 5309 (ne pas changer sans mettre à jour
# package.json, supabase/config.toml, et toute URL hardcodée)
CUPEL_DEV_PORT=5309
NEXT_PUBLIC_APP_NAME=cupel
NODE_ENV=development

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...           # SERVER ONLY — jamais NEXT_PUBLIC
SUPABASE_DB_URL=postgresql://postgres:...@db.xxx.supabase.co:5432/postgres
SUPABASE_PROJECT_REF=xxxxxxxx

# --- Cloudflare R2 (skill downloads) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=cupel-skills
R2_PUBLIC_URL=https://cdn.cupel.dev

# --- Lemon Squeezy ---
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# --- Stripe Connect (phase 2 — payouts créateurs) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# --- Anthropic (LLM review skills) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Sentry ---
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Plausible ---
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=cupel.dev
NEXT_PUBLIC_PLAUSIBLE_SCRIPT=https://plausible.io/js/script.js

# --- Better Stack Logs ---
BETTERSTACK_SOURCE_TOKEN=

# --- Resend (transactional email) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=cupel <hello@cupel.dev>

# --- Internal ---
INTERNAL_API_TOKEN=                          # rotation mensuelle
CRON_SECRET=                                 # protection routes cron
SKILL_SIGNING_PRIVATE_KEY=                   # Ed25519 PEM — signature manifests
